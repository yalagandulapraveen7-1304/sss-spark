{
  "version": 1,
  "author": "Anonymous maker",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_sensor", "top": -120, "left": -120, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_ref", "top": 120, "left": -120, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -80, "left": 150, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -30, "left": 150, "attrs": { "value": "220" } }
