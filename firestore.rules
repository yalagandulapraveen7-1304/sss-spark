rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // Device State Digital Twin
    // Web clients can read live state; only authenticated backend service accounts
    // can write/update telemetry snapshots.
    // -------------------------------------------------------------------------
    match /device_state/{deviceId} {
      allow read: if true;
      allow write: if false; // Disallow arbitrary public writes. Must go through trusted backend.
    }

    // -------------------------------------------------------------------------
    // Time-Series Telemetry Readings
    // Web clients can read historical telemetry for charts & tables.
    // Writes are strictly restricted to backend service accounts with admin SDK.
    // -------------------------------------------------------------------------
    match /readings/{readingId} {
      allow read: if true;
      allow write: if false; // Backend ingestion only
    }

    // -------------------------------------------------------------------------
    // Calibration Ledger Events
    // Audit log of calibration cycles and drift corrections.
    // -------------------------------------------------------------------------
    match /calibration_events/{eventId} {
      allow read: if true;
      allow write: if false; // Backend ingestion only
    }
  }
}
