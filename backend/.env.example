# Park-Assist Educational Telemetry Service Configuration
HOST=127.0.0.1
PORT=8000
DEVICE_ID=esp32-park-01
DEVICE_TOKEN=your-secure-device-token-here
DATABASE_PATH=park_assist.db
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com,*
DEBUG=False

# Firebase Database Configuration (Cloud Firestore & Realtime Database)
# Set USE_FIREBASE=true to persist readings to Google Cloud Firestore
USE_FIREBASE=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com/

# Path to service account key JSON file (local execution)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Alternatively, paste raw single-line JSON string (for Render cloud deployment)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "your-firebase-project-id", ...}
