# Park-Assist Educational Telemetry Service Configuration
HOST=127.0.0.1
PORT=8000
DEVICE_ID=esp32-park-01
DEVICE_TOKEN=dev-park-secret-token-2026
DATABASE_PATH=park_assist.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*
DEBUG=True

# Firebase Database Configuration (Cloud Firestore & Realtime Database)
# Enable Firebase by providing your Project ID and credentials
USE_FIREBASE=true
FIREBASE_PROJECT_ID=park-assist-telemetry
FIREBASE_DATABASE_URL=https://park-assist-telemetry-default-rtdb.firebaseio.com/

# Path to service account key JSON file (downloaded from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Alternatively, paste raw JSON string (ideal for Render / Cloud deployment environment variables)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "park-assist-telemetry", ...}
